# ---------------------------------------------------------------------------
# Konfiguration der DB-ICE-Live-Karte – alle Werte optional (Standardwerte vorbelegt).
# Es werden KEINE API-Schlüssel benötigt. Datei nach .env kopieren und anpassen.
# Format: KEY=Wert, keine Kommentare hinter Werten (Node --env-file, systemd EnvironmentFile, Docker env_file).
# ---------------------------------------------------------------------------

# Server
# (3000)
PORT=3000
# (0.0.0.0)
HOST=0.0.0.0
# production|development|test
NODE_ENV=production
# false|true|<Anzahl Proxies>|loopback – nur hinter Reverse-Proxy auf true/1 setzen
TRUST_PROXY=false
# z. B. https://bahn.paulbartsch.de (nur für Anzeige/Doku)
PUBLIC_BASE_URL=
# true, wenn TLS am Reverse-Proxy terminiert und HSTS gewünscht ist
HSTS_ENABLED=false
# debug|info|warn|error|silent
LOG_LEVEL=info
# json|pretty
LOG_FORMAT=json

# Karte (eigener Kartenserver, Vektor-Kacheln als PMTiles + style.json)
# vector|raster
MAP_MODE=vector
MAP_STYLE_URL=https://maps.paulbartsch.de/style/style.json
# weitere Origins für Glyphen/Kacheln, kommagetrennt (z. B. https://tiles.example.org)
MAP_EXTRA_ORIGINS=
MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende
MAP_CENTER_LON=10.45
MAP_CENTER_LAT=51.16
MAP_ZOOM=5.6
# Nur MAP_MODE=raster: Raster-Endpunkt ist auf den Server selbst beschränkt und wird serverseitig proxied
MAP_RASTER_URL_TEMPLATE=http://127.0.0.1:8080/raster/{z}/{x}/{y}.png
MAP_RASTER_MAX_ZOOM=14

# Fahrplan-/Echtzeitdaten (transport.rest – inoffizielle, öffentliche REST-API; oder eigene db-rest-Instanz)
TRANSPORT_API_BASE_URL=https://v6.db.transport.rest
# leer|dbnav|db|dbweb (db-vendo-client-Profil)
TRANSPORT_PROFILE=
# Projekt-URL UND E-Mail angeben (Fair Use, Erreichbarkeit)
USER_AGENT=db-ice-live-karte/0.1.0 (+https://github.com/terraformerpb/deutsche-bahn; kontakt@example.org)
# Anfragen/Minute an transport.rest (Limit dort: 100/min, Backend ~60/min)
UPSTREAM_MAX_RPM=40
UPSTREAM_CONCURRENCY=2
UPSTREAM_TIMEOUT_MS=12000
# nationalExpress (ICE) | nationalExpress,national (ICE + IC/EC)
TRACK_PRODUCTS=nationalExpress
# Abfrageintervall der Knoten-Abfahrtstafeln (Stufe 1)
HUB_POLL_INTERVAL_SEC=600
# Stufe-2-Knoten werden um diesen Faktor seltener abgefragt
HUB_TIER2_FACTOR=2
# zusätzlich Ankunftstafeln abfragen (mehr Anfragen, bessere Abdeckung endender Züge)
HUB_INCLUDE_ARRIVALS=false
# Mindestabstand zwischen zwei Aktualisierungen derselben Fahrt
TRIP_REFRESH_MIN_SEC=180
TRIP_MAX_TRACKED=400
TRIP_PREFETCH_BEFORE_DEPARTURE_MIN=20
TRIP_RETAIN_AFTER_ARRIVAL_MIN=10
BOARD_CACHE_SEC=60
UPSTREAM_CIRCUIT_COOLDOWN_SEC=60

# Wetter (DWD via Bright Sky, Fallback Open-Meteo; "none" deaktiviert)
WEATHER_PROVIDERS=brightsky,open-meteo
BRIGHTSKY_BASE_URL=https://api.brightsky.dev
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_REFRESH_SEC=600
WEATHER_ALERTS=true
WEATHER_POINT_QUERIES_PER_MIN=30

# Schutz der eigenen API
# Anfragen pro Minute und Client-IP
RATE_LIMIT_PER_MIN=120
# serverweit: durch Nutzer ausgelöste Upstream-Abrufe (Abfahrtstafeln, Detail-Aktualisierung) pro Minute
CLIENT_UPSTREAM_PER_MIN=12

# Demo-/Testbetrieb mit lokalem Mock-Upstream (keine externen Anfragen)
DEMO_MODE=false
