# ---------------------------------------------------------------------------
# Konfiguration der DB-ICE-Live-Karte – alle Werte optional (Standard in Klammern)
# Es werden KEINE API-Schlüssel benötigt. Datei nach .env kopieren und anpassen.
# ---------------------------------------------------------------------------

# Server
PORT=3000                      # (3000)
HOST=0.0.0.0                   # (0.0.0.0)
NODE_ENV=production            # production|development|test
TRUST_PROXY=false              # false|true|<Anzahl Proxies>|loopback – nur hinter Reverse-Proxy auf true/1 setzen
PUBLIC_BASE_URL=               # z. B. https://bahn.paulbartsch.de (nur für Anzeige/Doku)
HSTS_ENABLED=false             # true, wenn TLS am Reverse-Proxy terminiert und HSTS gewünscht ist
LOG_LEVEL=info                 # debug|info|warn|error|silent
LOG_FORMAT=json                # json|pretty

# Karte (eigener Kartenserver, Vektor-Kacheln als PMTiles + style.json)
MAP_MODE=vector                # vector|raster
MAP_STYLE_URL=https://maps.paulbartsch.de/style/style.json
MAP_EXTRA_ORIGINS=             # weitere Origins für Glyphen/Kacheln, kommagetrennt (z. B. https://tiles.example.org)
MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende
MAP_CENTER_LON=10.45
MAP_CENTER_LAT=51.16
MAP_ZOOM=5.6
# Nur MAP_MODE=raster: Raster-Endpunkt ist auf den Server selbst beschränkt und wird serverseitig proxied
MAP_RASTER_URL_TEMPLATE=http://127.0.0.1:8080/raster/{z}/{x}/{y}.png
MAP_RASTER_MAX_ZOOM=14

# Fahrplan-/Echtzeitdaten (transport.rest – inoffizielle, öffentliche REST-API; oder eigene db-rest-Instanz)
TRANSPORT_API_BASE_URL=https://v6.db.transport.rest
TRANSPORT_PROFILE=             # leer|dbnav|db|dbweb (db-vendo-client-Profil)
USER_AGENT=db-ice-live-karte/0.1.0 (+https://github.com/terraformerpb/deutsche-bahn)
UPSTREAM_MAX_RPM=40            # Anfragen/Minute an transport.rest (Limit dort: 100/min, Backend ~60/min)
UPSTREAM_CONCURRENCY=2
UPSTREAM_TIMEOUT_MS=12000
TRACK_PRODUCTS=nationalExpress # nationalExpress (ICE) | nationalExpress,national (ICE + IC/EC)
HUB_POLL_INTERVAL_SEC=600      # Abfrageintervall der Knoten-Abfahrtstafeln (Stufe 1)
HUB_TIER2_FACTOR=2             # Stufe-2-Knoten werden um diesen Faktor seltener abgefragt
HUB_INCLUDE_ARRIVALS=false     # zusätzlich Ankunftstafeln abfragen (mehr Anfragen, bessere Abdeckung endender Züge)
TRIP_REFRESH_MIN_SEC=180       # Mindestabstand zwischen zwei Aktualisierungen derselben Fahrt
TRIP_MAX_TRACKED=400
TRIP_PREFETCH_BEFORE_DEPARTURE_MIN=20
TRIP_RETAIN_AFTER_ARRIVAL_MIN=10
BOARD_CACHE_SEC=60
UPSTREAM_CIRCUIT_COOLDOWN_SEC=60

# Wetter (DWD via Bright Sky, Fallback Open-Meteo; "none" deaktiviert)
WEATHER_PROVIDERS=brightsky,open-meteo
BRIGHTSKY_BASE_URL=https://api.brightsky.dev
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_REFRESH_SEC=600
WEATHER_ALERTS=true
WEATHER_POINT_QUERIES_PER_MIN=30

# Schutz der eigenen API
RATE_LIMIT_PER_MIN=120         # Anfragen pro Minute und Client-IP

# Demo-/Testbetrieb mit lokalem Mock-Upstream (keine externen Anfragen)
DEMO_MODE=false
