{
  "name": "db-ice-live-karte",
  "version": "0.1.0",
  "description": "Live-Karte des deutschen ICE-/IC-Fernverkehrs (Positionen, Verspätungen, Störungen, Wetter) auf einer selbst gehosteten MapLibre/PMTiles-Karte",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node scripts/demo.js",
    "mock-upstream": "node scripts/mock-upstream.js",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js",
    "build:corridors": "node scripts/build-corridors.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node --test \"test-e2e/**/*.test.js\"",
    "lint": "node scripts/lint.js",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "playwright-core": "^1.58.0"
  }
}
